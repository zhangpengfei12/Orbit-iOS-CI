<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Orbit</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- App Icon：指向 Assets.xcassets 里的 AppIcon 集合（含 1024 源图，Xcode 缩放生成 120/152 等派生尺寸） -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<!-- iOS 14+ 可用空 UILaunchScreen 满足 iPad 多任务启动屏要求（无需 storyboard） -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- 前端 88 处 fetch() 全是同源相对路径，服务必须仍在 127.0.0.1:8787。
	     只放行本地网络，不要全局关闭 ATS。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- M2 设备链路需要 -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用于连接并控制已配对的硬件设备</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于通过局域网连接设备，以及访问局域网内的媒体共享</string>

	<!-- iPad 多任务强制要求支持全部四个方向（缺 portraitUpsideDown 会被拒） -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
