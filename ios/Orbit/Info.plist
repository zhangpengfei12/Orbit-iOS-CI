<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Orbit</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 相册：MediaPicker 走 PHPickerViewController（系统托管选择器，本身不弹权限）。
	     但缺这个描述串时，系统在「相册导入」路径上一律静默失败（不报错、不回调），
	     用户看到的就是「选了视频但什么都没发生」。必须声明。 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择视频导入 App 媒体库播放（仅读取您主动选中的视频）</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用于连接并控制已配对的硬件设备</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于通过局域网连接设备，以及访问局域网内的媒体共享</string>
	<!-- 手控触板的「陀螺仪 / 摇一摇」模式用 CoreMotion 取姿态与线性加速度。
	     iOS 不给这个描述串时 CMDeviceMotion 直接不返回数据（不是崩溃，是静默无数据）。 -->
	<key>NSMotionUsageDescription</key>
	<string>用于「手控触板」的陀螺仪与摇一摇模式，把手机姿态转成设备动作</string>
	<!-- iOS 没有前台服务 / 唤醒锁，App 进后台几秒即被挂起。
	     声明音频后台模式是这里唯一能合法延长运行时长的办法（随播时确实在出声）。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 本 App 只使用 HTTPS 等系统内置加密，属豁免范畴。
	     不声明的话每次上传 TestFlight 都会被判「Missing Compliance」需要手动确认。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- 配合 UIFileSharingEnabled：允许「文件」App 原地打开本 App 容器内的文件 -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 关键：不在相册 / 文件 App 的分享面板里注册文档类型，Orbit 根本不会出现在
	     「分享 → 发送到 App」列表中（表现为「相册视频无法发送到这个 App」）。
	     LSHandlerRank=Alternate 表示只作为候选打开方式，不抢系统默认播放器。 -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>视频</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.mpeg-4</string>
				<string>com.apple.quicktime-movie</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Funscript 交互脚本</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.orbit.funscript</string>
			</array>
		</dict>
	</array>
	<!-- .funscript 不是系统已知类型，必须自己声明，否则分享面板里同样看不到本 App -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.orbit.funscript</string>
			<key>UTTypeDescription</key>
			<string>Funscript 交互脚本</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>funscript</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
